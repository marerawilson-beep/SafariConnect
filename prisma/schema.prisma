generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  traveller
  vendor
  administrator
  super_administrator
}

enum ListingType {
  accommodation
  tour
  activity
  restaurant
}

enum BookingRequestStatus {
  pending
  accepted
  declined
  cancelled
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(traveller)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  listings      Listing[] @relation("ListingOwner")
  bookingRequests BookingRequest[] @relation("BookingTraveller")
  trips         Trip[]
  sentMessages  Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  wishlistItems WishlistItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Auth.js-compatible OAuth account records. Credentials sign-in uses JWTs,
// but these tables keep the model ready for a provider in a later milestone.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Shared marketplace record. Type-specific details belong to exactly one
// optional extension model, keeping common discovery fields in one place.
model Listing {
  id            String       @id @default(cuid())
  ownerId       String
  type          ListingType
  slug          String       @unique
  title         String
  description   String
  location      String
  priceFrom     Decimal      @db.Decimal(12, 2)
  currency      String       @default("KES")
  isPublished   Boolean      @default(false)
  owner         User         @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  images        ListingImage[]
  accommodation Accommodation?
  tour          Tour?
  activity      Activity?
  restaurant    Restaurant?
  bookingRequests BookingRequest[]
  messages      Message[]
  wishlistItems WishlistItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type, isPublished])
  @@index([location, isPublished])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  alt       String?
  position  Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

model Accommodation {
  id        String  @id @default(cuid())
  listingId String  @unique
  rooms     Int?
  guests    Int?
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Tour {
  id           String  @id @default(cuid())
  listingId    String  @unique
  durationDays Int
  maxGuests    Int?
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Activity {
  id              String  @id @default(cuid())
  listingId       String  @unique
  durationMinutes Int
  minAge          Int?
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id        String  @id @default(cuid())
  listingId String  @unique
  cuisine   String?
  address   String?
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model BookingRequest {
  id                String               @id @default(cuid())
  listingId         String
  travellerId       String
  status            BookingRequestStatus @default(pending)
  startDate         DateTime?
  endDate           DateTime?
  guests            Int?
  travellerMessage  String?
  listing           Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  traveller         User                 @relation("BookingTraveller", fields: [travellerId], references: [id], onDelete: Cascade)
  trip              Trip?
  messages          Message[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([travellerId, status])
  @@index([listingId, status])
}

model Trip {
  id               String         @id @default(cuid())
  bookingRequestId String         @unique
  travellerId      String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  traveller        User           @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime       @default(now())

  @@index([travellerId, startDate])
}

model Message {
  id               String          @id @default(cuid())
  bookingRequestId String?
  listingId        String?
  senderId         String
  recipientId      String
  content          String
  readAt           DateTime?
  createdAt        DateTime        @default(now())
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  listing          Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender           User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient        User            @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([bookingRequestId, createdAt])
  @@index([listingId, createdAt])
  @@index([recipientId, readAt])
}

model WishlistItem {
  id          String  @id @default(cuid())
  travellerId String
  listingId   String
  traveller   User    @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([travellerId, listingId])
  @@index([listingId])
}
